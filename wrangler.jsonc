{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "90gundem",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "triggers": { "crons": ["*/2 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "90gundem-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "X_PUBLISH_ENABLED": "false",
    "X_DAILY_POST_LIMIT": "20",
    "X_MAX_AGE_MINUTES": "3"
  }
}
